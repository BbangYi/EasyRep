          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version"
          },
          "site_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Site Id"
          },
          "gateway_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Gateway Id"
          },
          "sent_at": {
            "type": "string",
            "format": "date-time",
            "title": "Sent At"
          },
          "gateway": {
            "$ref": "#/components/schemas/GatewaySnapshot"
          },
          "events": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TelemetryEvent"
                },
                {
                  "$ref": "#/components/schemas/CommandEvent"
                }
              ],
              "discriminator": {
                "propertyName": "kind",
                "mapping": {
                  "command.updated": "#/components/schemas/CommandEvent",
                  "telemetry.recorded": "#/components/schemas/TelemetryEvent"
                }
              }
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Events"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "site_id",
          "gateway_id",
          "sent_at",
          "gateway",
          "events"
        ],
        "title": "SyncRequest"
      },
      "TelemetryEvent": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version"
          },
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "event_sequence": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Event Sequence"
          },
          "site_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Site Id"
          },
          "gateway_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Gateway Id"
          },
          "cage_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Cage Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "kind": {
            "type": "string",
            "const": "telemetry.recorded",
            "title": "Kind"
          },
          "payload": {
            "$ref": "#/components/schemas/StoredTelemetry"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "event_id",
          "event_sequence",
          "site_id",
          "gateway_id",
          "cage_id",
          "created_at",
          "kind",
          "payload"
        ],
        "title": "TelemetryEvent"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "PiBearerToken": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
