# Rendered by deploy/install_air_remote.py. Keep the private result outside source.
# TLS is terminated by the external tunnel. This listener is loopback only.
{
	admin off
	auto_https off
}

http://:@@LISTEN_PORT@@ {
	bind 127.0.0.1
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	route {
		basicauth {
			@@USERNAME@@ @@PASSWORD_HASH@@
		}
		reverse_proxy 127.0.0.1:@@UPSTREAM_PORT@@ {
			header_up -Authorization
		}
	}
}
