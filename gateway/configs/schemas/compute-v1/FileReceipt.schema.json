{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:habitatos:compute:1.0.0:FileReceipt",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "capture_id": {
      "format": "uuid",
      "title": "Capture Id",
      "type": "string"
    },
    "file_id": {
      "format": "uuid",
      "title": "File Id",
      "type": "string"
    },
    "size_bytes": {
      "exclusiveMinimum": 0,
      "maximum": 20971520,
      "title": "Size Bytes",
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "status": {
      "const": "verified",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "capture_id",
    "file_id",
    "size_bytes",
    "sha256",
    "status"
  ],
  "title": "FileReceipt",
  "type": "object"
}
