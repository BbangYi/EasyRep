[Unit]
Description=HabitatOS authenticated air viewer proxy
After=network-online.target habitat-air-viewer.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=habitat-air-remote
StateDirectoryMode=0700
Environment=HOME=/var/lib/habitat-air-remote
Environment=XDG_CONFIG_HOME=/var/lib/habitat-air-remote/config
Environment=XDG_DATA_HOME=/var/lib/habitat-air-remote/data
LoadCredential=Caddyfile:/etc/habitat-air-viewer/remote.Caddyfile
ExecStart=/usr/bin/caddy run --config %d/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=128M
CPUQuota=25%
UMask=0077

[Install]
WantedBy=multi-user.target
