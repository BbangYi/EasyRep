{
  "openapi": "3.1.0",
  "info": {
    "title": "HabitatOS Pi → SaaS ingestion contract",
    "description": "Reference implementation. The production URL requires deployment by the SaaS operator.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:9000",
      "description": "Local reference receiver"
    },
    {
      "url": "https://habitatos.kro.kr",
      "description": "Planned production server; not deployed by this example"
    }
  ],
  "paths": {
    "/v1/edge/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Health",
        "operationId": "edgeIngestHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/edge/sync": {
      "post": {
        "tags": [
          "Pi ingestion"
        ],
        "summary": "Store sensor/command events and acknowledge durable event IDs",
        "description": "All-or-nothing transaction. Retries with identical events return the same ACK. Empty events are valid heartbeats. Maximum JSON body: 8 MiB.",
        "operationId": "syncGatewayEvents",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncAck"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Pi token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Gateway/cage scope denied or simulation disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Event ID or sequence reused with different content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "JSON body exceeds 8 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Persistence failed; no ACK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "PiBearerToken": []
          }
        ]
      }
    }
  },
